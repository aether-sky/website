{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:site": "node scripts/public-site.mjs build",
    "release:site": "node scripts/public-site.mjs release",
    "test:release": "turbo run check:release",
    "check:release": "node --test tests/deployment/*.test.mjs",
    "dev:blog": "node scripts/dev-blog.mjs",
    "build:blog": "turbo run build --filter=personal-blog",
    "preview:blog": "turbo run preview --filter=personal-blog",
    "blog:new": "pnpm --filter personal-blog new-post",
    "verify:blog-import": "node scripts/verify-blog-import.mjs",
    "test:a11y": "pnpm build:blog && playwright test --config=playwright.a11y.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "turbo": "2.11.7"
  }
}
