{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:site": "node scripts/site.mjs build",
    "dev:home": "node scripts/site.mjs dev",
    "dev:site": "node scripts/site.mjs dev",
    "dev:site:live": "node scripts/site.mjs dev-live",
    "setup:home": "node scripts/setup-home.mjs",
    "dev:home:live": "node scripts/site.mjs dev-live",
    "eval:home:guardrails": "node scripts/python.mjs services/home/evaluate_requests.py",
    "test:home": "turbo run test --filter=@website/home-service",
    "test:home:ui": "pnpm build:site && turbo run test:ui --filter=@website/home-service",
    "dev:blog": "node scripts/dev-blog.mjs",
    "build:blog": "turbo run build --filter=personal-blog",
    "preview:blog": "turbo run preview --filter=personal-blog",
    "blog:new": "pnpm --filter personal-blog new-post",
    "verify:blog-import": "node scripts/verify-blog-import.mjs",
    "test:a11y": "pnpm build:blog && playwright test --config=playwright.a11y.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "turbo": "2.11.7"
  }
}
