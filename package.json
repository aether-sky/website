{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:blog": "turbo run dev --filter=personal-blog",
    "build:blog": "turbo run build --filter=personal-blog",
    "preview:blog": "turbo run preview --filter=personal-blog",
    "blog:new": "pnpm --filter personal-blog new-post",
    "verify:blog-import": "node scripts/verify-blog-import.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
